---
import { cv, t, type Lang } from "../data/cv";
import { ui } from "../i18n/ui";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang].sections.about;
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <SectionHead id="about-title" index="01" title={s.title} hint={s.hint} />

    <div class="about">
      <div class="about__text">
        {t(cv.about, lang).map((p) => <p>{p}</p>)}
      </div>

      <div class="about__side">
        <ul class="stats">
          {
            cv.stats.map((stat) => (
              <li class="card stat">
                <p class="stat__value">{stat.value}</p>
                <p class="stat__label">{t(stat.label, lang)}</p>
              </li>
            ))
          }
        </ul>
        <!-- MOUNT: E-03 process mailbox FIFO (set --fx-height when attaching) -->
        <div class="fx" data-effect="mailbox-fifo" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  .about__text {
    display: grid;
    gap: 1.1rem;
    max-width: 62ch;
    font-size: 1.08rem;
    color: var(--text);
  }
  .about__text p:first-child {
    font-size: clamp(1.15rem, 2.2vw, 1.3rem);
    line-height: 1.55;
  }
  .about__text p:not(:first-child) {
    color: var(--text-muted);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .stat {
    padding: 1.1rem 1.1rem 1rem;
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .stat__value {
    font-family: var(--font-mono);
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-text);
  }
  .stat__label {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  @media (min-width: 62rem) {
    .about {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }
  @media print {
    .about {
      grid-template-columns: 1.3fr 1fr;
      gap: 1rem;
    }
    .about__text {
      font-size: 1em;
      gap: 0.4rem;
    }
    .about__text p:first-child {
      font-size: 1em;
    }
    .stat {
      padding: 0.4rem 0.6rem;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 0.6rem;
    }
    .stat__value {
      font-size: 1.2rem;
    }
    .stats {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
