---
/** "DN" process-node monogram: a node with orbiting message dots. */
interface Props {
  initials: string;
  size?: number;
  label?: string | undefined;
}
const { initials, size = 96, label } = Astro.props;
---

<svg
  class="monogram"
  viewBox="0 0 96 96"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <circle class="orbit-path" cx="48" cy="48" r="42"></circle>
  <circle class="orbit-path" cx="48" cy="48" r="34"></circle>
  <g class="orbit o1"><circle class="dot d-msg" cx="48" cy="6" r="3.2"></circle></g>
  <g class="orbit o2"><circle class="dot d-ok" cx="48" cy="14" r="2.6"></circle></g>
  <g class="orbit o3"><circle class="dot d-warn" cx="48" cy="48" r="0"></circle><circle class="dot d-msg" cx="14" cy="48" r="2.2"></circle></g>
  <circle class="node" cx="48" cy="48" r="26"></circle>
  <text class="mark" x="48" y="48" text-anchor="middle" dominant-baseline="central">{initials}</text>
</svg>

<style>
  .monogram {
    flex: none;
    overflow: visible;
  }
  .orbit-path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 0.8;
    stroke-dasharray: 2 4;
    opacity: 0.8;
  }
  .node {
    fill: var(--surface);
    stroke: var(--accent-text);
    stroke-width: 2.5;
  }
  .mark {
    fill: var(--text);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.04em;
  }
  .dot {
    stroke: none;
  }
  .d-msg {
    fill: var(--msg);
  }
  .d-ok {
    fill: var(--ok);
  }
  .d-warn {
    fill: var(--warn);
  }
  .orbit {
    transform-origin: 48px 48px;
    animation: orbit 10s linear infinite;
  }
  .o2 {
    animation-duration: 16s;
    animation-direction: reverse;
  }
  .o3 {
    animation-duration: 24s;
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
</style>
