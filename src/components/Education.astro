---
import { cv, t, type Lang } from "../data/cv";
import { ui } from "../i18n/ui";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const text = ui[lang];
const s = text.sections.education;
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <SectionHead id="education-title" index="06" title={s.title} hint={s.hint} />

    <div class="edu">
      <div class="edu__main">
        <h3 class="sub">{text.degrees}</h3>
        <ul class="degrees">
          {
            cv.education.map((e, i) => (
              <li>
                <article class="card degree" aria-labelledby={`deg-${i}`}>
                  <p class="degree__dates">
                    <time datetime={e.start}>{e.start}</time>
                    {" → "}
                    <time datetime={e.end}>{e.end}</time>
                  </p>
                  <h4 id={`deg-${i}`}>{t(e.degree, lang)}</h4>
                  <p class="degree__school">{e.school}</p>
                  <ul class="notes">
                    {t(e.notes, lang).map((n) => <li>{n}</li>)}
                  </ul>
                </article>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="edu__side">
        <div>
          <h3 class="sub">{text.awards}</h3>
          <ul class="awards">
            {
              cv.awards.map((a) => (
                <li class="card award">
                  <span class="award__year">{a.year}</span>
                  <span>
                    <span class="award__title">{t(a.title, lang)}</span>
                    <span class="award__issuer">{a.issuer}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="sub">{text.languages}</h3>
          <ul class="langs">
            {
              cv.languages.map((l) => (
                <li class="card lang">
                  <span class="lang__name">{t(l.name, lang)}</span>
                  <span class="lang__level">{t(l.level, lang)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    gap: 2.5rem;
  }
  .sub {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .degrees,
  .awards,
  .langs,
  .edu__side {
    display: grid;
    gap: 0.75rem;
  }
  .edu__side {
    gap: 2rem;
    align-content: start;
  }
  .degree {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }
  .degree__dates {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  h4 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .degree__school {
    color: var(--accent-text);
    font-weight: 500;
    font-size: 0.93rem;
  }
  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.93rem;
  }
  .notes li {
    position: relative;
    padding-left: 1.2rem;
  }
  .notes li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--msg-text);
    font-family: var(--font-mono);
  }
  .award {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.8rem 1rem;
  }
  .award__year {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-text);
  }
  .award__title {
    display: block;
    font-weight: 600;
    font-size: 0.93rem;
    line-height: 1.4;
  }
  .award__issuer {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .lang {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    font-size: 0.93rem;
  }
  .lang__name {
    font-weight: 600;
  }
  .lang__level {
    color: var(--text-muted);
  }

  @media (min-width: 62rem) {
    .edu {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  @media print {
    .edu {
      grid-template-columns: 1.5fr 1fr;
      gap: 1rem;
    }
    .degree,
    .award,
    .lang {
      padding: 0.2rem 0;
      border: 0;
    }
    .degree {
      gap: 0.15rem;
    }
    .award {
      column-gap: 0.6rem;
    }
    .notes {
      margin-top: 0.1rem;
      gap: 0.1rem;
    }
    .edu__side {
      gap: 0.6rem;
    }
    .sub {
      margin-bottom: 0.3rem;
    }
  }
</style>
