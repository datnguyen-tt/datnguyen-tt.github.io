---
import { cv, t, type Lang } from "../data/cv";
import { repoSlug, ui } from "../i18n/ui";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const text = ui[lang];
const s = text.sections.projects;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <SectionHead id="projects-title" index="04" title={s.title} hint={s.hint} />

    <ul class="grid">
      {
        cv.projects.map((p) => (
          <li class="card project">
            <h3 class="project__name">
              <a href={p.repo} rel="noopener" aria-label={`${p.name} — ${text.viewRepo}`}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                {p.name}
              </a>
            </h3>
            <p class="project__desc">{t(p.description, lang)}</p>
            <ul class="chips">
              {p.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
            <p class="project__url">{repoSlug(p.repo)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, 17.5rem), 1fr)
    );
    gap: 1rem;
    justify-content: start;
  }
  .grid:has(> :only-child) {
    grid-template-columns: minmax(0, 42rem);
  }
  .grid:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 52rem;
  }
  .project {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.75rem;
    padding: 1.25rem;
    transition: border-color 0.15s, transform 0.15s;
  }
  .project:hover,
  .project:focus-within {
    border-color: var(--msg);
    transform: translateY(-2px);
  }
  .project__name {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .project__name a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }
  /* whole card is the click target */
  .project__name a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .project__name a:focus-visible {
    outline: none;
  }
  .project:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .project__name svg {
    color: var(--text-muted);
  }
  .project__desc {
    color: var(--text-muted);
    font-size: 0.93rem;
  }
  .project__url {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  @media print {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem 1rem;
    }
    .project {
      padding: 0;
      border: 0;
      gap: 0.1rem;
      transform: none;
    }
    .project__name svg,
    .project .chips,
    .project__url {
      display: none;
    }
    .project__name a::after {
      position: static;
    }
    .project__desc {
      display: none;
    }
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
