---
import { cv, STRATEGIES, t, type Lang } from "../data/cv";
import { ui } from "../i18n/ui";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const text = ui[lang];
const s = text.sections.skills;
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <SectionHead
      id="skills-title"
      index="03"
      title={s.title}
      hint={s.hint}
      hintSub={s.hintSub}
    />

    <!-- MOUNT: E-05 supervision tree (SSR console + global strategy control pre-rendered for 0 CLS) -->
    <div
      class="tree"
      data-effect="supervision-tree"
      data-restarted-prefix={text.fx.supRestartedPrefix}
      data-restarted-unit={text.fx.supRestartedUnit}
      data-escalated={text.fx.supEscalated}
    >
      <div class="sup-console js-only no-print">
        <div
          class="strategy-picker"
          role="radiogroup"
          aria-label={text.fx.supStrategyControl}
        >
          <span class="strategy-picker__label">{text.fx.supStrategyControl}:</span>
          <label class="strategy-opt">
            <input type="radio" name="sup-global-strategy" value="as_designed" checked />
            <span>{text.fx.supAsDesigned}</span>
          </label>
          {
            STRATEGIES.map((strat) => (
              <label class="strategy-opt">
                <input type="radio" name="sup-global-strategy" value={strat} />
                <span>{strat}</span>
              </label>
            ))
          }
        </div>
        <output class="sup-console__log" aria-live="polite" data-sup-output>
          <span class="sup-console__primary" data-sup-primary>{text.fx.supHint}</span>
          <code class="sup-console__sub" data-sup-sub>{text.fx.supIdle}</code>
        </output>
      </div>

      <ul class="tree__root">
        <li>
          <p class="node node--root">
            <code class="node__id">dat_sup</code>
            <span class="node__role">{text.supervisorLabel}</span>
          </p>
          <ul class="groups">
            {
              cv.skills.map((group) => (
                <li class="group" data-strategy={group.strategy} data-group={group.id}>
                  <p class="node">
                    <span class="node__name">{t(group.name, lang)}</span>
                    <code class="strategy" title={text.strategyLabel}>
                      {text.strategy[group.strategy]}
                    </code>
                  </p>
                  <ul class="workers">
                    {group.children.map((w) => (
                      <li class="worker">
                        <button type="button" class="worker__btn">
                          {w}
                        </button>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .node {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .node--root {
    border-color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
  }
  .node__id {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .node__role {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .node__name {
    font-weight: 600;
  }
  .strategy {
    padding: 0 0.5rem;
    border: 1px solid color-mix(in srgb, var(--msg) 55%, var(--border));
    border-radius: 5px;
    color: var(--msg-text);
    font-size: 0.74rem;
    line-height: 1.7;
  }

  /* Tree lines (pure CSS). The elbow lives on the node and is centred on
     it, so wrapped nodes still connect; the rail runs on each group. */
  .groups {
    --indent: 1.75rem;
    --gap: 0.9rem;
    margin-left: 1.1rem;
    padding-left: var(--indent);
  }
  .group {
    position: relative;
    padding-top: var(--gap);
  }
  .group:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--indent) * -1);
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--border-strong);
  }
  .group > .node {
    position: relative;
  }
  .group > .node::before {
    content: "";
    position: absolute;
    left: calc(var(--indent) * -1);
    top: calc(var(--gap) * -1);
    width: var(--indent);
    height: calc(var(--gap) + 50%);
    border-left: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .workers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.55rem 0 0 1.1rem;
    padding-left: 1.1rem;
    border-left: 1px dashed var(--border-strong);
  }
  .worker {
    display: inline-flex;
  }
  .worker__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.15rem 0.65rem 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s, color 0.15s, transform 0.15s;
  }
  /* green dot = process alive */
  .worker__btn::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
    transition: background-color 0.15s, transform 0.15s;
  }
  .worker__btn:hover {
    border-color: var(--msg);
  }
  .worker:global(.is-crashed) .worker__btn {
    border-color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 24%, var(--surface-2));
    color: var(--accent-text);
    transform: translateY(1px);
  }
  .worker:global(.is-crashed) .worker__btn::before {
    background: var(--accent-text);
  }
  .worker:global(.is-restarted) .worker__btn {
    border-color: var(--ok);
    background: color-mix(in srgb, var(--ok) 18%, var(--surface-2));
  }

  .sup-console {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
  }
  .sup-console__log {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .sup-console__primary {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--text);
  }
  .sup-console__sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .strategy-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
  }
  .strategy-picker__label {
    font-weight: 600;
    color: var(--text-muted);
    margin-right: 0.2rem;
  }
  .strategy-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    cursor: pointer;
    user-select: none;
  }
  .strategy-opt:has(input:checked) {
    border-color: var(--msg);
    color: var(--msg-text);
    background: color-mix(in srgb, var(--msg) 12%, var(--surface));
  }
  .strategy-opt:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .strategy-opt input {
    margin: 0;
    accent-color: var(--msg);
    width: 0.7rem;
    height: 0.7rem;
  }

  @media (min-width: 48rem) {
    .groups {
      --indent: 2.25rem;
      margin-left: 1.5rem;
    }
    .workers {
      margin-left: 1.5rem;
      padding-left: 1.5rem;
    }
  }

  @media print {
    .tree .node {
      border: 0;
      padding: 0;
      min-height: 0;
      background: none;
    }
    .node--root {
      display: none;
    }
    .groups {
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.3rem;
    }
    .group {
      padding: 0;
    }
    .group::after,
    .group > .node::before {
      display: none;
    }
    .group .node {
      display: inline;
      margin-right: 0.35rem;
      font-weight: 700;
    }
    /* L12: keep localized strategy badge visible in print */
    .strategy {
      display: inline;
      border: 0;
      padding: 0;
      margin-left: 0.25rem;
      color: var(--text-muted);
      font-weight: 400;
      font-size: 0.85em;
    }
    .strategy::before {
      content: "(";
    }
    .strategy::after {
      content: "):";
    }
    .workers {
      display: inline;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .worker {
      display: inline;
    }
    .worker__btn {
      display: inline;
      padding: 0;
      border: 0;
      background: none;
      font-family: var(--font-sans);
      font-size: 1em;
    }
    .worker__btn::before {
      display: none;
    }
    .worker:not(:last-child)::after {
      content: ", ";
    }
  }
</style>
