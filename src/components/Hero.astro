---
import { cv, t, type Lang } from "../data/cv";
import { ui } from "../i18n/ui";
import Monogram from "./Monogram.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const text = ui[lang];
const { meta, hero } = cv;
---

<section id="hero" class="section hero" aria-labelledby="hero-title">
  <!-- MOUNT: E-01 BEAM cluster. The wrapper sits behind the content
       (z-index:-1, pointer-events:none) so text stays clickable. The effect
       must give its <canvas> `pointer-events:auto`, `role="img"` and an
       `aria-label` describing the simulation (NFR-04). -->
  <div class="hero__fx" data-effect="beam-cluster"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__tagline">{t(meta.tagline, lang)}</p>
      <div class="hero__id">
        <Monogram initials={meta.initials} size={88} />
        <div>
          <h1 id="hero-title">{meta.name}</h1>
          <p class="hero__role">{t(meta.role, lang)}</p>
        </div>
      </div>
      <p class="hero__headline">{t(hero.headline, lang)}</p>
      <p class="hero__summary">{t(hero.summary, lang)}</p>

      <p class="hero__avail">
        <span class="dot" aria-hidden="true"></span>
        <span class="sr-only">{text.availability}: </span>
        {t(meta.availability, lang)}
      </p>

      <ul class="hero__cta">
        <li>
          <a class="btn btn--primary no-url no-print" href={meta.pdf} download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 20h16"></path></svg>
            {text.cta.download}
          </a>
        </li>
        <li>
          <a class="btn no-url" href="#contact">{text.cta.contact}</a>
        </li>
        <li>
          <a class="btn" href={meta.links.github} rel="me noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path></svg>
            {text.cta.github}
          </a>
        </li>
      </ul>
    </div>

    <figure class="terminal no-print">
      <figcaption class="terminal__bar">
        <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>{text.terminalTitle}</span>
      </figcaption>
      <div class="terminal__body" translate="no">
        {
          hero.terminal.map((line) => (
            <>
              <p class="ln"><span class="p">{line.prompt}</span> <span class="i">{line.input}</span></p>
              <p class="ln o">{line.output}</p>
            </>
          ))
        }
        <p class="ln"><span class="p">{`${hero.terminal.length + 1}>`}</span> <span class="cursor" aria-hidden="true"></span></p>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 7vw, 5.5rem);
    overflow: clip;
    isolation: isolate;
    border-top: 0;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 90%;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 60% at 15% 20%, var(--glow), transparent 70%),
      radial-gradient(ellipse 40% 50% at 85% 30%, var(--glow-2), transparent 70%);
  }
  .hero__fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .hero__tagline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--msg-text);
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
  }
  .hero__id {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .hero__role {
    margin-top: 0.35rem;
    color: var(--accent-text);
    font-weight: 600;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
  }
  .hero__headline {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 30ch;
  }
  .hero__summary {
    margin-top: 1rem;
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 1.03rem;
  }
  .hero__avail {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--text);
  }
  .dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  /* Static fake Erlang shell */
  .terminal {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-elev) 92%, transparent);
    box-shadow: var(--shadow);
    overflow: hidden;
    min-width: 0;
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .terminal__dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .terminal__dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .terminal__dots i:first-child {
    background: var(--accent);
  }
  .terminal__body {
    margin: 0;
    padding: 1.1rem 1.1rem 1.25rem;
    font-size: clamp(0.78rem, 2.4vw, 0.9rem);
    line-height: 1.75;
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .terminal__body .ln {
    margin: 0;
  }
  .terminal__body .ln.o {
    margin-bottom: 0.45rem;
  }
  .terminal__body .p {
    color: var(--text-muted);
  }
  .terminal__body .i {
    color: var(--msg-text);
  }
  .terminal__body .o {
    color: var(--text);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent-text);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  @media print {
    .hero {
      padding-top: 0;
    }
    .hero::before {
      display: none;
    }
    .hero__id {
      margin-bottom: 0.5rem;
    }
    .hero__id :global(svg) {
      display: none;
    }
    h1 {
      font-size: 2rem;
    }
    .hero__headline {
      font-size: 1.05rem;
      max-width: none;
    }
    .hero__summary {
      display: none;
    }
    .hero__cta li:first-child,
    .hero__avail .dot {
      display: none;
    }
    .hero__cta {
      margin-top: 0.6rem;
    }
    .btn {
      min-height: 0;
      padding: 0;
      border: 0;
      font-weight: 500;
    }
    .btn svg {
      display: none;
    }
  }
</style>
